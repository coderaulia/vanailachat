# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Server ---
# Fixed backend port. Unset = random ephemeral port written to .port.
PORT=

# NODE_ENV=production hides internal error details from API responses
# (full errors still go to the server log).
NODE_ENV=development

# Send Strict-Transport-Security. Only enable when served over HTTPS —
# on plaintext localhost it does nothing useful and can break access.
ENABLE_HSTS=

# --- Database ---
# SQLite file path. Default: ./data/vanaila.sqlite
DATABASE_PATH=

# Max rows retained in the memory table. Default: 5000
MEMORY_TABLE_CAP=

# Min completion tokens before a reply is auto-marked positive. Default: 200
AUTO_POSITIVE_MIN_TOKENS=

# --- Providers (secrets) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1

CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_MODELS=

# --- Coding workspace ---
# Used only by the Coding workspace. Keep it server-side; never expose it to the browser.
ANTHROPIC_API_KEY=
