{
  "name": "vanaila-chat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/predev.js",
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "node --import tsx --watch src/backend/index.ts",
    "dev:frontend": "vite",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "tsc --project tsconfig.backend.json",
    "build:frontend": "vite build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "backup": "node scripts/backup-db.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "tauri": "tauri",
    "desktop:dev": "node scripts/predev.js && tauri dev",
    "desktop:build": "tauri build",
    "desktop:icon": "tauri icon"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@hono/node-server": "^1.13.7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "dompurify": "^3.2.3",
    "duck-duck-scrape": "^2.2.7",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "hono": "^4.6.14",
    "marked": "^15.0.4",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.0.3",
    "vitest": "^3.1.2"
  }
}
