{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Vanaila Chat",
  "version": "0.3.1-fix",
  "identifier": "com.vanaila.chat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run predev && pnpm run dev:frontend",
    "beforeBuildCommand": "pnpm run build:frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Vanaila Chat",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "category": "Utility",
    "homepage": "https://github.com/coderaulia/vanailachat",
    "shortDescription": "Privacy-first, high-performance local AI chat client with multi-provider LLM support",
    "longDescription": "Vanaila Chat is a privacy-focused, local-first AI chat client supporting Ollama, OpenAI, Anthropic, OpenRouter, and custom endpoints. Features include agent tools, vector memory/RAG, skill plugins, personas, deep research, and A/B testing."
  }
}
